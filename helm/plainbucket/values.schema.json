{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plainbucket values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automount": {
          "type": "boolean"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "enableServiceLinks": {
      "type": "boolean"
    },
    "podSecurityContext": {
      "type": [
        "object",
        "null"
      ]
    },
    "securityContext": {
      "type": [
        "object",
        "null"
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "accessKeyKey": {
          "type": "string",
          "minLength": 1
        },
        "secretKeyKey": {
          "type": "string",
          "minLength": 1
        },
        "accessKey": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        },
        "credentialsSecret": {
          "type": "string"
        },
        "credentialsKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "region": {
          "type": "string",
          "minLength": 1
        },
        "publicBuckets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
            "not": {
              "pattern": "\\.\\."
            }
          },
          "uniqueItems": true
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$"
          },
          "uniqueItems": true
        },
        "maxObjectSize": {
          "type": "string",
          "pattern": "^[0-9]{0,18}$"
        },
        "minFreeSpace": {
          "type": "string",
          "pattern": "^[0-9]{0,18}$"
        },
        "uploadExpiry": {
          "type": "string",
          "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "not": {
            "pattern": "^(0+(\\.0+)?(ns|us|µs|ms|s|m|h))+$"
          }
        },
        "scrubInterval": {
          "type": "string",
          "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "not": {
            "pattern": "^(0+(\\.0+)?(ns|us|µs|ms|s|m|h))+$"
          }
        },
        "replicateInterval": {
          "type": "string",
          "pattern": "^$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "scrubRate": {
          "type": "string",
          "pattern": "^[0-9]{0,18}$"
        },
        "bodyTimeout": {
          "type": "string",
          "pattern": "^$|^0$|^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        },
        "metrics": {
          "type": "boolean"
        },
        "bucketMetrics": {
          "type": "boolean"
        },
        "console": {
          "type": "boolean"
        },
        "readOnly": {
          "type": "boolean"
        },
        "logFormat": {
          "enum": [
            "text",
            "json"
          ]
        },
        "debug": {
          "type": "boolean"
        },
        "tlsSecret": {
          "type": "string"
        },
        "tlsMinVers": {
          "enum": [
            "",
            "TLS12",
            "TLS13"
          ]
        },
        "buckets": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
            "not": {
              "pattern": "\\.\\."
            }
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "public": {
                "type": "boolean"
              },
              "website": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              },
              "cors": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "allowed-origins"
                ],
                "properties": {
                  "allowed-origins": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^*]*(\\*[^*]*)?$"
                    },
                    "minItems": 1
                  },
                  "allowed-methods": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "GET",
                        "HEAD",
                        "PUT",
                        "POST",
                        "DELETE"
                      ]
                    }
                  },
                  "allowed-headers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "expose-headers": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "max-age": {
                    "type": "string",
                    "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
                  }
                }
              },
              "expire-after": {
                "type": "string",
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
              },
              "trash-after": {
                "type": "string",
                "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
              },
              "max-size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740992
              },
              "evict": {
                "type": "boolean"
              },
              "notify": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "url"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://([^/?#@]*@)?[^/?#@]+([/?#].*)?$"
                    },
                    "events": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "s3:ObjectCreated:*",
                          "s3:ObjectCreated:Put",
                          "s3:ObjectCreated:Post",
                          "s3:ObjectCreated:Copy",
                          "s3:ObjectCreated:CompleteMultipartUpload",
                          "s3:ObjectRemoved:*",
                          "s3:ObjectRemoved:Delete",
                          "s3:LifecycleExpiration:*",
                          "s3:LifecycleExpiration:Delete"
                        ]
                      }
                    },
                    "prefix": {
                      "type": "string"
                    },
                    "suffix": {
                      "type": "string"
                    },
                    "secret-file": {
                      "type": "string",
                      "pattern": "^/"
                    }
                  }
                }
              },
              "headers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "set"
                  ],
                  "properties": {
                    "prefix": {
                      "type": "string"
                    },
                    "suffix": {
                      "type": "string"
                    },
                    "set": {
                      "type": "object",
                      "minProperties": 1,
                      "propertyNames": {
                        "enum": [
                          "Cache-Control",
                          "Content-Disposition",
                          "Content-Encoding",
                          "Content-Language",
                          "Expires",
                          "Permissions-Policy",
                          "Referrer-Policy",
                          "Strict-Transport-Security",
                          "X-Content-Type-Options",
                          "X-Frame-Options"
                        ]
                      },
                      "additionalProperties": {
                        "type": "string",
                        "maxLength": 4096,
                        "pattern": "^[\\t\\x20-\\x7e]*[\\x21-\\x7e][\\t\\x20-\\x7e]*$"
                      }
                    }
                  }
                }
              },
              "lifecycle": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "prefix": {
                      "type": "string"
                    },
                    "expire-after": {
                      "type": "string",
                      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
                    },
                    "delete-after": {
                      "type": "string",
                      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
                    }
                  }
                }
              },
              "replicate": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "endpoint",
                    "bucket",
                    "access-key",
                    "secret-key-file"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "endpoint": {
                      "type": "string",
                      "pattern": "^https?://[^/?#@]+/?$"
                    },
                    "region": {
                      "type": "string"
                    },
                    "bucket": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
                    },
                    "prefix": {
                      "type": "string"
                    },
                    "virtual-hosted": {
                      "type": "boolean"
                    },
                    "access-key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "secret-key-file": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "delete": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "evict"
                  ],
                  "properties": {
                    "evict": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "required": [
                    "max-size"
                  ],
                  "properties": {
                    "max-size": {
                      "minimum": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "website"
                  ]
                },
                "then": {
                  "required": [
                    "public"
                  ],
                  "properties": {
                    "public": {
                      "const": true
                    }
                  }
                }
              }
            ]
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "number",
              "minimum": 0
            },
            "burst": {
              "type": "integer",
              "minimum": 0
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740992
            }
          }
        },
        "anonymousRateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "number",
              "minimum": 0
            },
            "burst": {
              "type": "integer",
              "minimum": 0
            },
            "bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740992
            }
          }
        },
        "notifySecret": {
          "type": "string"
        },
        "replicateSecret": {
          "type": "string"
        },
        "accessLog": {
          "type": "boolean"
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "pathType"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": [
        "object",
        "null"
      ]
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 3
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "subPath": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessMode": {
          "enum": [
            "ReadWriteOnce",
            "ReadWriteOncePod",
            "ReadWriteMany"
          ]
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "keep": {
          "type": "boolean"
        }
      }
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "tlsConfig": {
          "type": "object"
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "selector": {
          "type": "string"
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "down": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "errors": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                },
                "ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            },
            "writesRefused": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "diskLow": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                },
                "ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            },
            "bucketNearLimit": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                },
                "ratio": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                }
              }
            },
            "notificationsFailing": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "corruptObjects": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "for": {
                  "type": "string",
                  "pattern": "^([0-9]+(ms|s|m|h|d|w|y))+$"
                },
                "severity": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "additionalRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "expr"
            ]
          }
        }
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "namespace": {
          "type": "string"
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "terminationGracePeriodSeconds": {
      "type": [
        "integer",
        "string"
      ],
      "pattern": "^[0-9]*$",
      "minimum": 0
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
